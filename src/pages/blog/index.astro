---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .map((post) => ({
    ...post,
    slug: post.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/, ''),
    domains: Array.isArray(post.data.domain)
      ? post.data.domain
      : post.data.domain
        ? [post.data.domain]
        : ['Computer Vision'],
    stage: post.data.stage || 'Deep Dive',
    specs: post.data.specs || []
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Extract unique tags for dropdown
const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort();

// Featured post (first one or explicitly marked featured)
const featuredPost = posts.find((p) => p.data.featured) || posts[0];
const gridPosts = posts.filter((p) => p.slug !== featuredPost?.slug);

// Domain filters matching the 6 core CV domains
const filterDomains = [
  { id: 'all', label: 'All' },
  { id: 'Classical', label: 'Classical CV' },
  { id: 'Deep Learning', label: 'Deep Learning' },
  { id: 'Detection & Tracking', label: 'Detection & Tracking' },
  { id: '3D Vision', label: '3D Vision' },
  { id: 'Generative AI', label: 'Generative AI' },
  { id: 'MLOps', label: 'MLOps' },
];
---

<Layout
  title="Blog & Research Notes — BaoNV"
  description="Deep dives into Computer Vision, Paper Reproductions, and Real-time Edge Deployment logs."
  canonicalPath="/blog/"
>
  <main class="content-shell blog-page-shell">
    
    <!-- 1. TOP BAR: DOMAIN CHIPS + TAG DROPDOWN + INSTANT SEARCH -->
    <section class="blog-top-bar" aria-label="Bộ lọc và tìm kiếm bài viết">
      <div class="filter-chips-group" role="tablist" aria-label="Lọc theo lĩnh vực">
        {filterDomains.map((dm, idx) => (
          <button
            class={`filter-chip-btn ${idx === 0 ? 'is-active' : ''}`}
            data-domain={dm.id}
            type="button"
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {dm.label}
          </button>
        ))}
      </div>

      <div class="top-bar-controls-right">
        <!-- TAGS SELECTOR DROPDOWN -->
        <div class="tags-dropdown-wrapper">
          <label for="blog-tag-select" class="visually-hidden">Lọc theo thẻ</label>
          <div class="custom-select-box">
            <svg class="select-tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
              <line x1="7" y1="7" x2="7.01" y2="7" />
            </svg>
            <select id="blog-tag-select" class="blog-tag-select" aria-label="Chọn thẻ chuyên môn">
              <option value="all">🏷️ Tất cả thẻ ({allTags.length})</option>
              {allTags.map((tag) => {
                const count = posts.filter((p) => p.data.tags?.includes(tag)).length;
                return (
                  <option value={tag.toLowerCase()}>#{tag} ({count})</option>
                );
              })}
            </select>
            <svg class="select-chevron-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </div>
        </div>

        <!-- SEARCH INPUT -->
        <div class="search-box-wrapper">
          <svg class="search-box-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            id="blog-search-input"
            class="blog-search-input"
            placeholder="Tìm bài viết, kỹ năng..."
            aria-label="Tìm bài viết"
            autocomplete="off"
          />
        </div>
      </div>
    </section>

    <!-- 2. FEATURED POST CARD (WIDE 2-COL HERO) -->
    {featuredPost && (
      <section
        class="featured-post-section"
        id="featured-post-container"
        data-domain={featuredPost.domains.join(',')}
        data-title={featuredPost.data.title.toLowerCase()}
        data-desc={featuredPost.data.description.toLowerCase()}
        data-tags={(featuredPost.data.tags || []).join(',').toLowerCase()}
      >
        <article class="featured-card">
          <a href={`/blog/${featuredPost.slug}/`} class="featured-card-inner">
            <div class="featured-cover-box">
              {featuredPost.data.coverImage ? (
                <img
                  src={typeof featuredPost.data.coverImage === 'string' ? featuredPost.data.coverImage : featuredPost.data.coverImage.src}
                  alt={featuredPost.data.title}
                  class="featured-cover-img"
                  loading="eager"
                />
              ) : (
                <div class="cover-placeholder" />
              )}
            </div>

            <div class="featured-content-box">
              <div class="card-badges-row">
                <span class="badge-featured">Featured</span>
                {featuredPost.domains.map((dm: string) => (
                  <span class="badge-domain">{dm}</span>
                ))}
              </div>

              <h2 class="featured-title">{featuredPost.data.title}</h2>
              <p class="featured-excerpt">{featuredPost.data.description}</p>

              <div class="card-meta-row">
                <time datetime={featuredPost.data.date.toISOString()}>
                  {featuredPost.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                </time>
                {featuredPost.data.readingTime && (
                  <>
                    <span class="meta-dot">·</span>
                    <span>{featuredPost.data.readingTime}</span>
                  </>
                )}
                {featuredPost.data.category && (
                  <>
                    <span class="meta-dot">·</span>
                    <span class="meta-category">{featuredPost.data.category}</span>
                  </>
                )}
              </div>
            </div>
          </a>
        </article>
      </section>
    )}

    <!-- 3. UNIFORM CARD GRID -->
    <section class="blog-grid-section" aria-label="Danh sách bài viết">
      <div class="cv-posts-grid" id="cv-posts-grid">
        {gridPosts.map((post) => (
          <article
            class="cv-post-card"
            data-domain={post.domains.join(',')}
            data-title={post.data.title.toLowerCase()}
            data-desc={post.data.description.toLowerCase()}
            data-tags={(post.data.tags || []).join(',').toLowerCase()}
          >
            <a href={`/blog/${post.slug}/`} class="cv-card-link">
              <div class="cv-card-cover-box">
                {post.data.coverImage ? (
                  <img
                    src={typeof post.data.coverImage === 'string' ? post.data.coverImage : post.data.coverImage.src}
                    alt={post.data.title}
                    class="cv-card-cover-img"
                    loading="lazy"
                  />
                ) : (
                  <div class="cover-placeholder" />
                )}
              </div>

              <div class="cv-card-body">
                <div class="cv-card-top-tags" style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                  {post.domains.map((dm: string) => (
                    <span class="badge-domain">{dm}</span>
                  ))}
                </div>

                <h3 class="cv-card-title">{post.data.title}</h3>
                <p class="cv-card-desc">{post.data.description}</p>

                <div class="cv-card-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                  {post.data.readingTime && (
                    <>
                      <span class="meta-dot">·</span>
                      <span>{post.data.readingTime}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div id="blog-empty-state" class="blog-empty-state" hidden>
        <p>Không tìm thấy bài viết nào phù hợp với bộ lọc hoặc từ khóa tìm kiếm.</p>
        <button type="button" class="btn-reset-filters" id="btn-reset-filters">Đặt lại bộ lọc</button>
      </div>

      <!-- 4. CLIENT-SIDE PAGINATION -->
      <nav id="blog-pagination" class="blog-pagination" aria-label="Phân trang danh sách bài viết" hidden>
        <button type="button" class="pagination-btn" id="pagination-prev" aria-label="Trang trước">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          <span>Trước</span>
        </button>

        <div class="pagination-pages" id="pagination-pages"></div>

        <button type="button" class="pagination-btn" id="pagination-next" aria-label="Trang sau">
          <span>Sau</span>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </nav>
    </section>

  </main>
</Layout>

<script>
  function setupCvBlogFilters() {
    const chipBtns = document.querySelectorAll<HTMLButtonElement>('.filter-chip-btn');
    const tagSelect = document.getElementById('blog-tag-select') as HTMLSelectElement | null;
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const featuredContainer = document.getElementById('featured-post-container');
    const gridCards = document.querySelectorAll<HTMLElement>('.cv-post-card');
    const emptyState = document.getElementById('blog-empty-state');
    const resetBtn = document.getElementById('btn-reset-filters');

    const paginationNav = document.getElementById('blog-pagination');
    const paginationPages = document.getElementById('pagination-pages');
    const prevBtn = document.getElementById('pagination-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('pagination-next') as HTMLButtonElement | null;

    if (!gridCards.length && !featuredContainer) return;

    const POSTS_PER_PAGE = 6;
    let currentPage = 1;
    let matchingCards: HTMLElement[] = [];
    let isFeaturedMatching = false;

    let selectedDomain = 'all';
    let selectedTag = 'all';
    let searchQuery = '';

    function scrollToTopGridIfNeeded() {
      const target = document.getElementById('cv-posts-grid');
      if (target) {
        const rect = target.getBoundingClientRect();
        if (rect.top < 60) {
          const headerOffset = 90;
          const elementPosition = rect.top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      }
    }

    function goToPage(page: number) {
      const totalPages = Math.ceil(matchingCards.length / POSTS_PER_PAGE);
      if (page < 1 || page > totalPages || page === currentPage) return;
      currentPage = page;
      updatePageDisplay();
      scrollToTopGridIfNeeded();
    }

    function renderPagination(totalPages: number) {
      if (!paginationNav || !paginationPages || !prevBtn || !nextBtn) return;

      if (totalPages <= 1) {
        paginationNav.hidden = true;
        paginationNav.style.display = 'none';
        paginationPages.innerHTML = '';
        return;
      }

      paginationNav.hidden = false;
      paginationNav.style.display = 'flex';
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      paginationPages.innerHTML = '';

      const createBtn = (p: number) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `pagination-page-btn ${p === currentPage ? 'is-active' : ''}`;
        btn.textContent = String(p);
        btn.dataset.page = String(p);
        btn.setAttribute('aria-label', `Trang ${p}`);
        if (p === currentPage) {
          btn.setAttribute('aria-current', 'page');
        }
        return btn;
      };

      const createEllipsis = () => {
        const span = document.createElement('span');
        span.className = 'pagination-ellipsis';
        span.textContent = '…';
        span.setAttribute('aria-hidden', 'true');
        return span;
      };

      if (totalPages <= 6) {
        for (let i = 1; i <= totalPages; i++) {
          paginationPages.appendChild(createBtn(i));
        }
      } else {
        paginationPages.appendChild(createBtn(1));

        let start = Math.max(2, currentPage - 1);
        let end = Math.min(totalPages - 1, currentPage + 1);

        if (currentPage <= 3) {
          start = 2;
          end = 4;
        } else if (currentPage >= totalPages - 2) {
          start = totalPages - 3;
          end = totalPages - 1;
        }

        if (start > 2) paginationPages.appendChild(createEllipsis());
        for (let i = start; i <= end; i++) {
          paginationPages.appendChild(createBtn(i));
        }
        if (end < totalPages - 1) paginationPages.appendChild(createEllipsis());

        paginationPages.appendChild(createBtn(totalPages));
      }
    }

    function updatePageDisplay() {
      const totalPages = Math.ceil(matchingCards.length / POSTS_PER_PAGE);

      if (totalPages <= 1) {
        if (paginationNav) {
          paginationNav.hidden = true;
          paginationNav.style.display = 'none';
        }
      } else {
        if (paginationNav) {
          paginationNav.hidden = false;
          paginationNav.style.display = 'flex';
        }
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        // Cập nhật đổi màu trạng thái active cho nút số trang
        const pageBtns = paginationPages?.querySelectorAll<HTMLButtonElement>('.pagination-page-btn');
        pageBtns?.forEach((btn) => {
          const p = Number(btn.dataset.page);
          const isActive = p === currentPage;
          btn.classList.toggle('is-active', isActive);
          if (isActive) {
            btn.setAttribute('aria-current', 'page');
          } else {
            btn.removeAttribute('aria-current');
          }
        });
      }

      // Hiển thị các bài viết thuộc trang hiện tại
      const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
      const endIndex = startIndex + POSTS_PER_PAGE;

      matchingCards.forEach((card, idx) => {
        if (idx >= startIndex && idx < endIndex) {
          card.style.display = '';
          card.classList.remove('fade-in');
          void card.offsetWidth; // Trigger reflow for smooth animation
          card.classList.add('fade-in');
        } else {
          card.style.display = 'none';
          card.classList.remove('fade-in');
        }
      });

      // Featured post: luôn hiển thị cố định nếu khớp bộ lọc
      if (featuredContainer) {
        featuredContainer.style.display = isFeaturedMatching ? '' : 'none';
      }
    }

    function filterPosts(resetToFirstPage = true) {
      if (resetToFirstPage) {
        currentPage = 1;
      }

      const q = searchQuery.trim().toLowerCase();

      // 1. Filter Featured Post
      isFeaturedMatching = false;
      if (featuredContainer) {
        const fDomains = (featuredContainer.dataset.domain || '').toLowerCase().split(',').map(d => d.trim());
        const fTitle = featuredContainer.dataset.title || '';
        const fDesc = featuredContainer.dataset.desc || '';
        const fTags = (featuredContainer.dataset.tags || '').toLowerCase().split(',');
        const fStage = (featuredContainer.dataset.stage || '').toLowerCase();

        const domainMatch =
          selectedDomain === 'all' ||
          fDomains.some(
            (d) =>
              d === selectedDomain.toLowerCase() ||
              (selectedDomain.toLowerCase() === 'classical' && (d === 'classical' || d === 'classical cv')) ||
              (selectedDomain.toLowerCase().includes('detection') && d.includes('detection'))
          ) ||
          fTags.includes(selectedDomain.toLowerCase());
        const tagMatch = selectedTag === 'all' || fTags.includes(selectedTag.toLowerCase()) || fStage.includes(selectedTag.toLowerCase());
        const searchMatch = !q || fTitle.includes(q) || fDesc.includes(q) || fDomains.some(d => d.includes(q)) || fStage.includes(q) || fTags.some(t => t.includes(q));

        if (domainMatch && tagMatch && searchMatch) {
          isFeaturedMatching = true;
        }
      }

      // 2. Filter Grid Posts
      matchingCards = [];
      gridCards.forEach((card) => {
        const cDomains = (card.dataset.domain || '').toLowerCase().split(',').map(d => d.trim());
        const cTitle = card.dataset.title || '';
        const cDesc = card.dataset.desc || '';
        const cTags = (card.dataset.tags || '').toLowerCase().split(',');
        const cStage = (card.dataset.stage || '').toLowerCase();

        const domainMatch =
          selectedDomain === 'all' ||
          cDomains.some(
            (d) =>
              d === selectedDomain.toLowerCase() ||
              (selectedDomain.toLowerCase() === 'classical' && (d === 'classical' || d === 'classical cv')) ||
              (selectedDomain.toLowerCase().includes('detection') && d.includes('detection'))
          ) ||
          cTags.includes(selectedDomain.toLowerCase());
        const tagMatch = selectedTag === 'all' || cTags.includes(selectedTag.toLowerCase()) || cStage.includes(selectedTag.toLowerCase());
        const searchMatch = !q || cTitle.includes(q) || cDesc.includes(q) || cDomains.some(d => d.includes(q)) || cStage.includes(q) || cTags.some(t => t.includes(q));

        if (domainMatch && tagMatch && searchMatch) {
          matchingCards.push(card);
        } else {
          card.style.display = 'none';
        }
      });

      const totalVisible = matchingCards.length + (isFeaturedMatching ? 1 : 0);
      if (emptyState) {
        emptyState.hidden = totalVisible > 0;
      }

      const totalPages = Math.ceil(matchingCards.length / POSTS_PER_PAGE);
      renderPagination(totalPages);
      updatePageDisplay();
    }

    paginationPages?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.pagination-page-btn') as HTMLButtonElement | null;
      if (!btn || !btn.dataset.page) return;
      goToPage(Number(btn.dataset.page));
    });

    prevBtn?.addEventListener('click', () => {
      goToPage(currentPage - 1);
    });

    nextBtn?.addEventListener('click', () => {
      goToPage(currentPage + 1);
    });

    chipBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        chipBtns.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        selectedDomain = btn.dataset.domain || 'all';
        filterPosts(true);
      });
    });

    tagSelect?.addEventListener('change', (e) => {
      selectedTag = (e.target as HTMLSelectElement).value;
      filterPosts(true);
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      filterPosts(true);
    });

    resetBtn?.addEventListener('click', () => {
      selectedDomain = 'all';
      selectedTag = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (tagSelect) tagSelect.value = 'all';

      chipBtns.forEach((b, idx) => {
        b.classList.toggle('is-active', idx === 0);
        b.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
      });

      filterPosts(true);
    });

    // Initial run
    filterPosts(true);
  }

  document.addEventListener('astro:page-load', setupCvBlogFilters);
</script>
