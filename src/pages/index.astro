---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => !project.data.draft)
  .map((project) => ({
    ...project,
    slug: project.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/, '')
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((post) => !post.data.draft)
  .map((post) => ({
    ...post,
    slug: post.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/, '')
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const domains = [
  {
    title: "Object Detection & Tracking",
    description: "SOTA real-time detection, multi-object tracking (ByteTrack, BoT-SORT), low-latency edge inference with TensorRT and ONNX Runtime.",
    tags: ["Object Detection", "ByteTrack", "YOLOv11", "TensorRT"],
    primaryTag: "Object Detection",
    icon: "crosshair"
  },
  {
    title: "3D Vision & Gaussian Splatting",
    description: "Novel view synthesis, 3D Gaussian Splatting (3DGS), depth estimation (Depth Anything), and photorealistic neural rendering.",
    tags: ["3D Vision", "Gaussian Splatting", "CUDA", "Math"],
    primaryTag: "3D Vision",
    icon: "box"
  },
  {
    title: "Real-time Edge Deployment",
    description: "Quantization (INT8/FP16), pruning, C++ inference runtimes, ONNX WebGPU, and client-side zero-server execution.",
    tags: ["WebGPU", "ONNX", "Edge AI", "Quantization"],
    primaryTag: "Edge AI",
    icon: "cpu"
  },
  {
    title: "Multimodal & Vision-Language",
    description: "Visual reasoning, zero-shot open-vocabulary detection, Multimodal LLMs (LLaVA, Florence-2), and Visual RAG architectures.",
    tags: ["Multimodal", "Vision-Language", "Florence-2", "CLIP"],
    primaryTag: "Multimodal",
    icon: "brain"
  },
  {
    title: "Generative Vision & Diffusion",
    description: "Latent diffusion models, ControlNet conditionings, LoRA fine-tuning, image restoration, and latent synthesis.",
    tags: ["Diffusion", "Generative AI", "ControlNet", "LoRA"],
    primaryTag: "Diffusion",
    icon: "sparkles"
  },
  {
    title: "Segmentation & Foundation Models",
    description: "Zero-shot promptable segmentation, interactive video mask propagation (SAM 2), and fine-grained semantic parsing.",
    tags: ["SAM 2", "Video Segmentation", "Paper Reproduction"],
    primaryTag: "SAM 2",
    icon: "scissors"
  }
];

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'BaoNV',
  jobTitle: 'Computer Vision Engineer',
  url: 'https://baocodeai.github.io',
  sameAs: [
    'https://github.com/baocodeai',
    'https://huggingface.co/vubaonguyen',
    'https://linkedin.com/in/vubaonguyen',
  ],
}).replace(/</g, '\\u003c');
---

<Layout
  title="BaoNV — Computer Vision Engineer"
  description="Computer Vision Engineer — detection, 3D reconstruction, real-time edge deployment."
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={personSchema} />

  <main class="content-shell">
    <!-- 1. HERO SECTION -->
    <section class="hero-section" aria-label="Introduction">
      <div class="hero-container">
        <div class="hero-status-pill">
          <span class="status-pulse-dot"></span>
          <span>Computer Vision & Edge AI</span>
        </div>

        <h1 class="hero-title">
          Computer Vision Engineer
          <span class="hero-subtitle-line">— detection, 3D reconstruction, real-time deployment</span>
        </h1>

        <p class="hero-lede-text">
          Turning state-of-the-art vision papers into high-throughput interactive systems.
          Specializing in WebGPU/ONNX client-side execution, 3D Gaussian Splatting, and low-latency edge deployment.
        </p>

        <div class="hero-actions-group">
          <a class="btn-primary" href="#featured-projects">
            <span>View Projects</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a class="btn-secondary" href="https://github.com/baocodeai" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.64 7.64 0 0 1 8 3.87c.68 0 1.36.09 2 .26 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. TECHNICAL DOMAINS SECTION -->
    <section class="section domain-section" aria-label="Technical Domains">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Technical Domains</h2>
          <p class="section-subtitle">Core areas of research, engineering, and edge deployment.</p>
        </div>
      </div>

      <div class="domains-grid">
        {domains.map((d) => (
          <a href={`/tags/${encodeURIComponent(d.primaryTag)}/`} class="domain-card" title={`Xem các bài viết về ${d.title}`}>
            <div class="domain-card-header">
              <div class="domain-icon-wrapper">
                {d.icon === 'crosshair' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="22" y1="12" x2="18" y2="12" />
                    <line x1="6" y1="12" x2="2" y2="12" />
                    <line x1="12" y1="6" x2="12" y2="2" />
                    <line x1="12" y1="22" x2="12" y2="18" />
                  </svg>
                )}
                {d.icon === 'box' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                    <line x1="12" y1="22.08" x2="12" y2="12" />
                  </svg>
                )}
                {d.icon === 'cpu' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <rect x="9" y="9" width="6" height="6" />
                    <line x1="9" y1="1" x2="9" y2="4" />
                    <line x1="15" y1="1" x2="15" y2="4" />
                    <line x1="9" y1="20" x2="9" y2="23" />
                    <line x1="15" y1="20" x2="15" y2="23" />
                    <line x1="20" y1="9" x2="23" y2="9" />
                    <line x1="20" y1="14" x2="23" y2="14" />
                    <line x1="1" y1="9" x2="4" y2="9" />
                    <line x1="1" y1="14" x2="4" y2="14" />
                  </svg>
                )}
                {d.icon === 'brain' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.54" />
                    <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.54" />
                  </svg>
                )}
                {d.icon === 'sparkles' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z" />
                  </svg>
                )}
                {d.icon === 'scissors' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="6" cy="6" r="3" />
                    <circle cx="6" cy="18" r="3" />
                    <line x1="20" y1="4" x2="8.12" y2="15.88" />
                    <line x1="14.47" y1="14.48" x2="20" y2="20" />
                    <line x1="8.12" y1="8.12" x2="12" y2="12" />
                  </svg>
                )}
              </div>
              <span class="domain-explore-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17l10-10" />
                  <path d="M7 7h10v10" />
                </svg>
              </span>
            </div>

            <h3 class="domain-card-title">{d.title}</h3>
            <p class="domain-card-desc">{d.description}</p>

            <div class="domain-tags-list">
              {d.tags.map((t) => (
                <span class="domain-tag">#{t}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. FEATURED PROJECTS SECTION -->
    <section class="section" id="featured-projects" aria-label="Featured Projects">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Featured Projects</h2>
          <p class="section-subtitle">Real-time demos running client-side with WebGPU, ONNX & TensorRT.</p>
        </div>
        <a class="section-header-link" href="/projects/">
          <span>live demos</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="featured-projects-grid">
        {featuredProjects.map((p) => (
          <article class="featured-project-card">
            <div class="project-preview-box">
              <div class="project-preview-badge">
                <span class="pulse-green-dot"></span>
                <span>{p.data.badge || "Live Demo"}</span>
              </div>
              <div class="project-preview-mock">
                <div class="mock-grid-lines"></div>
                <div class="mock-camera-frame">
                  <span class="mock-box-1"></span>
                  <span class="mock-box-2"></span>
                  <span class="mock-fps">45+ FPS (WebGPU)</span>
                </div>
              </div>
            </div>

            <div class="featured-project-body">
              <div class="project-domain-label">{p.data.domain || "Computer Vision"}</div>
              <h3 class="featured-project-title">
                <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
              </h3>
              <p class="featured-project-desc">{p.data.description}</p>

              <div class="project-tech-tags">
                {p.data.techStack.map((tech: string) => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>

              <div class="featured-project-cta">
                {p.data.demoUrl && (
                  <a href={p.data.demoUrl} class="btn-demo-primary" target="_blank" rel="noopener noreferrer">
                    <span>Live Demo</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17l10-10" />
                      <path d="M7 7h10v10" />
                    </svg>
                  </a>
                )}
                {p.data.repoUrl && (
                  <a href={p.data.repoUrl} class="btn-demo-subtle" target="_blank" rel="noopener noreferrer">
                    <span>Code</span>
                  </a>
                )}
                <a href={`/projects/${p.slug}/`} class="btn-demo-subtle">
                  <span>Details</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. RECENT POSTS SECTION -->
    <section class="section" aria-label="Recent Posts">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Recent Posts</h2>
          <p class="section-subtitle">Paper reproductions, architectural deep dives & deployment logs.</p>
        </div>
        <a class="section-header-link" href="/blog/">
          <span>view all</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="recent-posts-grid">
        {recentPosts.map((post) => (
          <article class="recent-post-card">
            <a class="post-card-full-link" href={`/blog/${post.slug}/`}>
              <div class="post-card-thumb-area">
                {post.data.coverImage ? (
                  <img
                    src={typeof post.data.coverImage === 'string' ? post.data.coverImage : post.data.coverImage.src}
                    alt={post.data.title}
                    class="post-card-cover-img"
                    loading="lazy"
                  />
                ) : (
                  <div class="post-thumb-abstract-visual">
                    <div class="visual-node node-a"></div>
                    <div class="visual-node node-b"></div>
                    <div class="visual-edge"></div>
                  </div>
                )}
                <div class="post-thumb-category-tag">
                  {post.data.category || (post.data.tags[0] ?? "Deep Dives")}
                </div>
              </div>

              <div class="recent-post-content">
                <div class="recent-post-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                  {post.data.readingTime && (
                    <>
                      <span class="meta-dot">·</span>
                      <span>{post.data.readingTime}</span>
                    </>
                  )}
                </div>

                <h3 class="recent-post-title">{post.data.title}</h3>
                <p class="recent-post-excerpt">{post.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
