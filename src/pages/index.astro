---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import { SITE_CONFIG } from '../site.config';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => !project.data.draft)
  .map((project) => ({
    ...project,
    slug: project.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/, '')
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((post) => !post.data.draft)
  .map((post) => ({
    ...post,
    slug: post.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/, '')
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const domains = [
  {
    title: "Classical Vision",
    description: "Xử lý ảnh số, lọc ảnh, phát hiện cạnh Canny/Sobel, trích xuất đặc trưng SIFT/ORB và Homography.",
    tag: "Classical",
    image: "/covers/classical-cv.jpg"
  },
  {
    title: "Deep Learning Architectures",
    description: "Kiến trúc CNN, Vision Transformers (ViT, Swin), kỹ thuật training, data augmentation và transfer learning.",
    tag: "Deep Learning",
    image: "/covers/deep-learning.jpg"
  },
  {
    title: "Detection, Segmentation & Tracking",
    description: "Phát hiện đối tượng real-time với YOLOv11, RT-DETR, SAM 2, Faster R-CNN và theo dõi đa đối tượng trong video.",
    tag: "Detection",
    image: "/covers/detection.jpg"
  },
  {
    title: "3D Vision & Neural Rendering",
    description: "Camera calibration, stereo matching, 3D reconstruction từ point cloud, NeRF, và 3D Gaussian Splatting (3DGS).",
    tag: "3D Vision",
    image: "/covers/3d-vision.jpg"
  },
  {
    title: "Generative AI & Multimodal",
    description: "Stable Diffusion, ControlNet, LoRA fine-tuning, Vision-Language Models (CLIP, LLaVA), và Visual RAG.",
    tag: "Generative AI",
    image: "/covers/generative-ai.jpg"
  },
  {
    title: "MLOps & Edge Optimization",
    description: "Triển khai model với TensorRT, ONNX Runtime, lượng tử hóa INT8/FP16, WebGPU inference và monitoring.",
    tag: "MLOps",
    image: "/covers/mlops.jpg"
  }
];

// Helper to count articles per domain tag
const getDomainPostCount = (tag: string) => {
  return allPosts.filter((p) => {
    if (p.data.draft) return false;
    const postDomains = Array.isArray(p.data.domain)
      ? p.data.domain
      : p.data.domain
        ? [p.data.domain]
        : [];
    return (
      postDomains.some((d) => d.toLowerCase() === tag.toLowerCase()) ||
      p.data.tags?.some((t) => t.toLowerCase() === tag.toLowerCase())
    );
  }).length;
};

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'BaoNV',
  jobTitle: 'Computer Vision Engineer',
  url: 'https://baocodeai.github.io',
  sameAs: [
    'https://github.com/baocodeai',
    'https://huggingface.co/vubaonguyen',
    'https://linkedin.com/in/vubaonguyen',
  ],
}).replace(/</g, '\\u003c');
---

<Layout
  title="BaoNV — Computer Vision Engineer"
  description="Computer Vision Engineer"
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={personSchema} />

  <main class="content-shell">
    <!-- 1. HERO SECTION -->
    <section class="hero-section" aria-label="Introduction">
      <div class="hero-container">
        <div class="hero-top-classified">
          <div class="hero-status-pill">
            <span class="status-pulse-dot"></span>
            <span>Computer Vision & Edge AI</span>
          </div>
          <div class="vault-classified-badge">
            <span class="vault-dot"></span>
            <span>[SYS_STATUS: ONLINE // CUDA_CORES: ACTIVE]</span>
          </div>
        </div>

        <h1 class="hero-title">
          Computer Vision Engineer
        </h1>

        <div class="hero-actions-group">
          {SITE_CONFIG.showProjects ? (
            <a class="btn-primary" href="#featured-projects">
              <span>View Projects</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          ) : (
            <a class="btn-primary" href="/blog/">
              <span>Explore Blog</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          )}
          <a class="btn-secondary" href="https://github.com/baocodeai" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.64 7.64 0 0 1 8 3.87c.68 0 1.36.09 2 .26 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. TECHNICAL DOMAINS SECTION -->
    <section class="section domain-section" aria-label="Technical Domains">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Technical Domains</h2>
          <p class="section-subtitle">Core areas of research, engineering, and edge deployment.</p>
        </div>
      </div>

      <div class="domains-grid">
        {domains.map((d) => {
          const count = getDomainPostCount(d.tag);
          return (
            <a href={`/tags/${encodeURIComponent(d.tag)}/`} class="domain-card domain-card-banner" title={`Xem các bài viết về ${d.title}`}>
              <div class="domain-banner-wrapper">
                <img src={d.image} alt={d.title} class="domain-banner-img" loading="lazy" />
                <span class="domain-explore-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l10-10" />
                    <path d="M7 7h10v10" />
                  </svg>
                </span>
              </div>

              <div class="domain-card-body">
                <h3 class="domain-card-title">{d.title}</h3>
                <p class="domain-card-desc">{d.description}</p>

                <div class="domain-tags-list" style="display: flex; justify-content: space-between; align-items: center;">
                  <span class="domain-tag">#{d.tag}</span>
                  <span style="font-size: 0.78rem; font-family: var(--mono); color: var(--muted);">{count > 0 ? `${count} bài viết` : 'Chưa có bài'}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 3. FEATURED PROJECTS SECTION -->
    {SITE_CONFIG.showProjects && featuredProjects.length > 0 && (
      <section class="section" id="featured-projects" aria-label="Featured Projects">
        <div class="section-header-row">
          <div>
            <h2 class="section-title">Featured Projects</h2>
            <p class="section-subtitle">Real-time demos running client-side with WebGPU, ONNX & TensorRT.</p>
          </div>
          <a class="section-header-link" href="/projects/">
            <span>live demos</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="featured-projects-grid">
          {featuredProjects.map((p) => (
            <article class="featured-project-card">
              <div class="project-preview-box">
                <div class="project-preview-badge">
                  <span class="pulse-green-dot"></span>
                  <span>{p.data.badge || "Live Demo"}</span>
                </div>
                <div class="project-preview-mock">
                  <div class="mock-grid-lines"></div>
                  <div class="mock-camera-frame">
                    <span class="mock-box-1"></span>
                    <span class="mock-box-2"></span>
                    <span class="mock-fps">45+ FPS (WebGPU)</span>
                  </div>
                </div>
              </div>

              <div class="featured-project-body">
                <div class="project-domain-label">{Array.isArray(p.data.domain) ? p.data.domain.join(' · ') : (p.data.domain || "Computer Vision")}</div>
                <h3 class="featured-project-title">
                  <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
                </h3>
                <p class="featured-project-desc">{p.data.description}</p>

                <div class="project-tech-tags">
                  {p.data.techStack.map((tech: string) => (
                    <span class="tech-badge">{tech}</span>
                  ))}
                </div>

                <div class="featured-project-cta">
                  {p.data.demoUrl && (
                    <a href={p.data.demoUrl} class="btn-demo-primary" target="_blank" rel="noopener noreferrer">
                      <span>Live Demo</span>
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17l10-10" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </a>
                  )}
                  {p.data.repoUrl && (
                    <a href={p.data.repoUrl} class="btn-demo-subtle" target="_blank" rel="noopener noreferrer">
                      <span>Code</span>
                    </a>
                  )}
                  <a href={`/projects/${p.slug}/`} class="btn-demo-subtle">
                    <span>Details</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- 4. RECENT POSTS SECTION -->
    <section class="section" aria-label="Recent Posts">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Recent Posts</h2>
          <p class="section-subtitle">Paper reproductions, architectural deep dives & deployment logs.</p>
        </div>
        <a class="section-header-link" href="/blog/">
          <span>view all</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="recent-posts-grid">
        {recentPosts.map((post) => (
          <article class="recent-post-card">
            <a class="post-card-full-link" href={`/blog/${post.slug}/`}>
              <div class="post-card-thumb-area">
                {post.data.coverImage ? (
                  <img
                    src={typeof post.data.coverImage === 'string' ? post.data.coverImage : post.data.coverImage.src}
                    alt={post.data.title}
                    class="post-card-cover-img"
                    loading="lazy"
                  />
                ) : (
                  <div class="post-thumb-abstract-visual">
                    <div class="visual-node node-a"></div>
                    <div class="visual-node node-b"></div>
                    <div class="visual-edge"></div>
                  </div>
                )}
                <div class="post-thumb-category-tag">
                  {post.data.category || (post.data.tags[0] ?? "Deep Dives")}
                </div>
              </div>

              <div class="recent-post-content">
                <div class="recent-post-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                  {post.data.readingTime && (
                    <>
                      <span class="meta-dot">·</span>
                      <span>{post.data.readingTime}</span>
                    </>
                  )}
                </div>

                <h3 class="recent-post-title">{post.data.title}</h3>
                <p class="recent-post-excerpt">{post.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    const setupSpotlights = () => {
      const cards = document.querySelectorAll<HTMLElement>('.domain-card, .featured-project-card, .recent-post-card');
      cards.forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    };

    setupSpotlights();
    document.addEventListener('astro:after-swap', setupSpotlights);
  </script>
</Layout>
