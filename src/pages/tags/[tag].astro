---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import TypedLede from '../../components/TypedLede.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag) && !post.data.draft)
      .map((post) => ({ ...post, slug: post.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/, '') }))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
      
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout
  title={`Posts tagged with "${tag}" — Your Name`}
  description={`All articles related to ${tag}.`}
  canonicalPath={`/tags/${tag}/`}
>
  <main class="content-shell">
    <section class="page-hero">
      <a href="/blog/" class="back-link">← Quay lại Blog</a>
      <h1 class="visually-hidden">Tags</h1>
      <TypedLede text={`Các bài viết có kỹ năng: ${tag}`} />
    </section>

    <section class="section" aria-label={`Blog posts tagged with ${tag}`}>
      {posts.length === 0 ? (
        <p style="color: var(--muted); font-family: var(--mono);">Chưa có bài viết nào.</p>
      ) : (
        <div class="post-list">
          {posts.map((post, index) => (
            <article class="post-card">
              <a class="post-card-link" href={`/blog/${post.slug}/`}>
                <div class="post-card-content">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <p class="post-card-meta">{post.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
                </div>
                {post.data.coverImage && (
                  <div class="post-cover-container">
                    <img class="post-cover-image" src={post.data.coverImage.src || post.data.coverImage} alt={post.data.title} />
                  </div>
                )}
              </a>
              {post.data.tags && post.data.tags.length > 0 && (
                <div style="margin-top: 0.2rem; margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  {post.data.tags.map((t: string) => (
                    <a href={`/tags/${t}/`} class={t === tag ? "tag-pill active" : "tag-pill"}>#{t}</a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.5rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 1px solid var(--line-strong);
    padding: 0.35rem 0.85rem;
    border-radius: 999px; /* Pill shape */
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    z-index: 2;
  }
  .tag-pill:hover,
  .tag-pill.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .tag-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--accent-soft);
  }
</style>
