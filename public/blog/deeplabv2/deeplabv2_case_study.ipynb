    "# 2. Dataset & Dataloaders (Tương thích đường dẫn đa môi trường)\n",
    "def resolve_data_dir():\n",
    "    current_dir = Path().resolve()\n",
    "    candidates = [\n",
    "        current_dir.parent / 'data' / 'processed' / '2',\n",
    "        current_dir / 'data' / 'processed' / '2',\n",
    "        current_dir.parent / 'data' / 'processed' / '1',\n",
    "        current_dir / 'data' / 'processed' / '1',\n",
    "        Path('/content/data/processed/2'),\n",
    "        Path('/content/data/processed')\n",
    "    ]\n",
    "    for c in candidates:\n",
    "        if (c / 'train_256' / 'images.npy').exists():\n",
    "            return c\n",
    "    return current_dir.parent / 'data' / 'processed' / '2'\n",
    "\n",
    "DATA_DIR = resolve_data_dir()\n",
    "print(f'Thư mục dữ liệu đang sử dụng: {DATA_DIR}')\n",
    "\n",
    "class FastSkinDataset(Dataset):\n",
    "    \"\"\"Dataset nạp sẵn dữ liệu vào RAM để tối ưu tốc độ đọc đĩa.\"\"\"\n",
    "    def __init__(self, data_dir, is_train=False):\n",
    "        self.is_train = is_train\n",
    "        images_path = os.path.join(data_dir, 'images.npy')\n",
    "        masks_path = os.path.join(data_dir, 'masks.npy')\n",
    "        ids_path = os.path.join(data_dir, 'image_ids.npy')\n",
    "\n",
    "        self.images = np.load(images_path)\n",
    "        self.masks = np.load(masks_path) if os.path.exists(masks_path) else None\n",
    "        self.image_ids = np.load(ids_path) if os.path.exists(ids_path) else None\n",
    "\n",
    "        self.mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)\n",
    "        self.std = np.array([0.229, 0.224, 0.225], dtype=np.float32)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.images)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        image = self.images[idx]\n",
    "        if self.masks is not None:\n",
    "            mask = self.masks[idx]\n",
    "            if self.is_train:\n",
    "                image, mask = apply_augmentations(image, mask)\n",
    "            image_norm = (image.astype(np.float32) / 255.0 - self.mean) / self.std\n",
    "            image_tensor = torch.from_numpy(image_norm).permute(2, 0, 1).float()\n",
    "            mask_tensor = torch.from_numpy(mask).float().unsqueeze(0)\n",
    "            return image_tensor, mask_tensor, image\n",
    "\n",
    "        image_norm = (image.astype(np.float32) / 255.0 - self.mean) / self.std\n",
    "        image_tensor = torch.from_numpy(image_norm).permute(2, 0, 1).float()\n",
    "        sample_id = self.image_ids[idx] if self.image_ids is not None else str(idx)\n",
    "        return image_tensor, sample_id, image\n",
    "\n",
    "def get_dataloaders(processed_base=DATA_DIR, batch_size=16, num_workers=0):\n",
    "    \"\"\"Tạo DataLoaders cho các tập Train, Validation và Test.\"\"\"\n",
    "    train_loader = DataLoader(FastSkinDataset(os.path.join(processed_base, 'train_256'), is_train=True), batch_size=batch_size, shuffle=True, num_workers=num_workers, pin_memory=True if torch.cuda.is_available() else False, drop_last=True)\n",
    "    val_loader   = DataLoader(FastSkinDataset(os.path.join(processed_base, 'val_256'),   is_train=False), batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=True if torch.cuda.is_available() else False, drop_last=False)\n",
    "    test_loader  = DataLoader(FastSkinDataset(os.path.join(processed_base, 'test_256'),  is_train=False), batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=True if torch.cuda.is_available() else False, drop_last=False)\n",
    "    return train_loader, val_loader, test_loader"
   ]
  },
