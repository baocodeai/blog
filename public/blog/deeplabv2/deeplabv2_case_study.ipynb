    "        small_crf.append(m_crf)\n",
    "    elif area_ratio <= 30.0:\n",
    "        medium_raw.append(m_raw)\n",
    "        medium_crf.append(m_crf)\n",
    "    else:\n",
    "        large_raw.append(m_raw)\n",
    "        large_crf.append(m_crf)\n",
