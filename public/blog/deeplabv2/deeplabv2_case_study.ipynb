    "\n",
    "history = {'train_loss': [], 'train_dice': [], 'val_loss': [], 'val_dice': [], 'lr': []}\n",
    "\n",
    "print('BẮT ĐẦU HUẤN LUYỆN DEEPLABV2 TRÊN TẬP DỮ LIỆU ISIC 2018...')\n",
    "print('=' * 75)\n",
    "\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    start_time = time.time()\n",
    "\n",
    "    # 1. Train\n",
    "    model.train()\n",
    "    train_loss, train_dice = 0.0, 0.0\n",
    "    pbar = tqdm(train_loader, desc=f'Epoch {epoch:02d}/{EPOCHS:02d} [Train]', leave=False)\n",
    "    for images, masks, _ in pbar:\n",
    "        images, masks = images.to(device, non_blocking=True), masks.to(device, non_blocking=True)\n",
    "        optimizer.zero_grad()\n",
    "\n",
    "        with autocast(enabled=(device.type == 'cuda')):\n",
    "            outputs = model(images)\n",
    "            loss = combined_loss(outputs, masks)\n",
    "\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "        scheduler.step()\n",
    "\n",
    "        bs = images.size(0)\n",
    "        train_loss += loss.item() * bs\n",
    "        train_dice += dice_score(outputs.detach(), masks) * bs\n",
    "        pbar.set_postfix({'loss': f'{loss.item():.4f}', 'dice': f'{dice_score(outputs.detach(), masks):.4f}'})\n",
    "\n",
    "    train_loss /= len(train_dataset)\n",
    "    train_dice /= len(train_dataset)\n",
    "\n",
    "    # 2. Validation\n",
    "    model.eval()\n",
    "    val_loss, val_dice = 0.0, 0.0\n",
    "    with torch.no_grad():\n",
    "        for images, masks, _ in val_loader:\n",
    "            images, masks = images.to(device, non_blocking=True), masks.to(device, non_blocking=True)\n",
    "            with autocast(enabled=(device.type == 'cuda')):\n",
    "                outputs = model(images)\n",
    "                loss = combined_loss(outputs, masks)\n",
    "            bs = images.size(0)\n",
    "            val_loss += loss.item() * bs\n",
    "            val_dice += dice_score(outputs, masks) * bs\n",
    "\n",
    "    val_loss /= len(val_dataset)\n",
    "    val_dice /= len(val_dataset)\n",
    "    cur_lr = scheduler.get_lr()[1]\n",
    "    elapsed = time.time() - start_time\n",
    "\n",
    "    history['train_loss'].append(train_loss)\n",
    "    history['train_dice'].append(train_dice)\n",
    "    history['val_loss'].append(val_loss)\n",
    "    history['val_dice'].append(val_dice)\n",
    "    history['lr'].append(cur_lr)\n",
    "\n",
    "    print(f'Epoch [{epoch:02d}/{EPOCHS:02d}] ({elapsed:.1f}s) | Train Loss: {train_loss:.4f}, Dice: {train_dice:.4f} | Val Loss: {val_loss:.4f}, Dice: {val_dice:.4f} | LR: {cur_lr:.2e}')\n",
    "\n",
    "    early_stopping(val_dice, model, epoch=epoch, optimizer=optimizer)\n",
    "    if early_stopping.early_stop:\n",
    "        print('Dừng sớm do mô hình không cải thiện!')\n",
    "        break\n",
    "\n",
    "print('=' * 75)\n",
    "print(f'HOÀN TẤT HUẤN LUYỆN! Best Val Dice Score = {early_stopping.best_metric:.4f}')\n"
