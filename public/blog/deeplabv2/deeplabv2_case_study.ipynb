    "EPOCHS = 20\n",
    "total_iters = EPOCHS * len(train_loader)\n",
    "\n",
    "class PolyLRScheduler:\n",
    "    def __init__(self, opt, base_lrs, max_iters, power=0.9):\n",
    "        self.opt = opt\n",
    "        self.base_lrs = base_lrs\n",
    "        self.max_iters = max_iters\n",
    "        self.power = power\n",
    "        self.cur_iter = 0\n",
    "    def step(self):\n",
    "        self.cur_iter += 1\n",
    "        factor = (1.0 - min(self.cur_iter, self.max_iters) / self.max_iters) ** self.power\n",
    "        for i, pg in enumerate(self.opt.param_groups):\n",
    "            pg['lr'] = self.base_lrs[i] * factor\n",
    "    def get_lr(self):\n",
    "        return [pg['lr'] for pg in self.opt.param_groups]\n",
    "\n",
    "scheduler = PolyLRScheduler(optimizer, [2.5e-5, 2.5e-4], total_iters, power=0.9)\n",
    "scaler = GradScaler(enabled=(device.type == 'cuda'))\n",
    "early_stopping = EarlyStopping(patience=8, mode='max', save_path=best_model_path)"
   ]
